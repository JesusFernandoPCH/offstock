{
  "$description": "Offstock design tokens. Single source for Flutter (core/theme) and Next.js (CSS variables). Direction: warm, tactile, Mexican corner-store vernacular.",
  "color": {
    "light": {
      "bg":          { "value": "#FAF5F2", "name": "Algodón",        "role": "app background" },
      "surface":     { "value": "#FFFFFF", "name": "Papel",          "role": "cards, sheets, tags" },
      "ink":         { "value": "#2B1630", "name": "Tinta",          "role": "primary text (plum, never pure black)" },
      "inkSoft":     { "value": "#6E5A70", "name": "Tinta suave",    "role": "secondary text" },
      "accent":      { "value": "#E4007C", "name": "Rosa mexicano",  "role": "primary actions, brand" },
      "accentLip":   { "value": "#A3005A", "name": "Rosa profundo",  "role": "tactile button edge" },
      "accentText":  { "value": "#C4006A", "name": "Rosa texto",     "role": "accent as small text (AA)" },
      "onAccent":    { "value": "#FFFFFF", "role": "text on accent" },
      "hold":        { "value": "#F2A007", "name": "Cempasúchil",    "role": "reserved stock, warnings" },
      "onHold":      { "value": "#2B1630" },
      "ok":          { "value": "#1F7A55", "name": "Nopal",          "role": "confirmed, synced, in stock" },
      "danger":      { "value": "#C2311A", "name": "Chile",          "role": "errors, out of stock" },
      "line":        { "value": "#EADFE3", "role": "dividers, input borders" },
      "shadow":      { "value": "#5A2A4A", "role": "shadow tint (used at low alpha)" }
    },
    "dark": {
      "bg":          { "value": "#1C1220" },
      "surface":     { "value": "#2A1C2F" },
      "ink":         { "value": "#F6ECF2" },
      "inkSoft":     { "value": "#BFA9C2" },
      "accent":      { "value": "#FF4FA3" },
      "accentLip":   { "value": "#B8126A" },
      "accentText":  { "value": "#FF4FA3" },
      "onAccent":    { "value": "#1C1220" },
      "hold":        { "value": "#FFB835" },
      "onHold":      { "value": "#1C1220" },
      "ok":          { "value": "#4CC38A" },
      "danger":      { "value": "#FF6B57" },
      "line":        { "value": "#3D2B42" },
      "shadow":      { "value": "#000000" }
    }
  },
  "font": {
    "family": "Bricolage Grotesque",
    "fallback": ["system-ui", "sans-serif"],
    "note": "One variable family. opsz/wdth axes give display vs body contrast. Prices use tabular figures.",
    "scale": {
      "total":   { "size": 44, "weight": 800, "opsz": 96, "wdth": 88 },
      "title":   { "size": 28, "weight": 700, "opsz": 48, "wdth": 92 },
      "heading": { "size": 20, "weight": 650, "opsz": 24 },
      "body":    { "size": 16, "weight": 420, "opsz": 14, "lineHeight": 1.5 },
      "label":   { "size": 14, "weight": 560, "opsz": 12 },
      "caption": { "size": 12, "weight": 500, "opsz": 12 }
    }
  },
  "space": [4, 8, 12, 16, 24, 32, 48],
  "radius": { "chip": 999, "button": 16, "tag": 14, "sheet": 28 },
  "elevation": {
    "lip":     "0 4px 0 accentLip",
    "pressed": "0 1px 0 accentLip",
    "float":   "0 10px 24px -10px shadow@35%"
  },
  "motion": {
    "duration": { "press": 90, "fast": 160, "base": 240, "slow": 320 },
    "spring":   { "stiffness": 520, "damping": 26, "mass": 1 },
    "rules": [
      "Motion answers a touch: press, scan, add, confirm. No ambient animation.",
      "Nothing that blocks a sale lasts longer than 320ms.",
      "Hang tags swing from their hole when added; tickets slide out like printer paper.",
      "Totals roll to the new value; never jump.",
      "Respect reduced motion: replace movement with a 120ms fade."
    ]
  },
  "haptics": { "scanOk": "light", "addToCart": "selection", "saleConfirmed": "medium", "error": "heavy" }
}

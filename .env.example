# Copy to .env (git-ignored) and fill in. Only PUBLIC values belong here.
# Supabase Dashboard → Project Settings → API Keys
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google Cloud → Google Auth Platform → Clients → the *Web* client ID (public; the secret goes only in Supabase).
# Leave empty to hide the Google button.
GOOGLE_WEB_CLIENT_ID=

# Email + code login needs an SMTP provider. Local Supabase has one (Mailpit at http://127.0.0.1:54324);
# the cloud project does not yet, so keep this false when pointing at the cloud.
EMAIL_LOGIN=false

# Never put the secret key (sb_secret_...) or the DB password in this file.
# Secret key → Supabase Edge Function secrets only. DB password → your password manager.
